{
  "name": "lordis-react-components",
  "type": "module",
  "version": "1.8.0",
  "description": "My personal React component library.",
  "homepage": "https://react.lordimass.net",
  "bugs": {
    "url": "https://github.com/Lordimass/Lordis-React-Components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lordimass/Lordis-React-Components.git"
  },
  "license": "Apache-2.0",
  "author": "Lordimass (lordimass.net)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "./dist"
  ],
  "exports": {
    "./config": {
      "types": "./dist/config.d.cts",
      "import": "./dist/config.mjs",
      "require": "./dist/config.cjs"
    },
    "./datatypes": {
      "types": "./dist/datatypes.d.cts",
      "import": "./dist/datatypes.mjs",
      "require": "./dist/datatypes.cjs"
    },
    "./contexts": {
      "types": "./dist/contexts.d.cts",
      "import": "./dist/contexts.mjs",
      "require": "./dist/contexts.cjs"
    },
    "./formatting": {
      "types": "./dist/formatting.d.cts",
      "import": "./dist/formatting.mjs",
      "require": "./dist/formatting.cjs"
    },
    "./price": {
      "types": "./dist/price.d.cts",
      "import": "./dist/price.mjs",
      "require": "./dist/price.cjs"
    },
    "./image": {
      "types": "./dist/image.d.cts",
      "import": "./dist/image.mjs",
      "require": "./dist/image.cjs"
    },
    "./routing": {
      "types": "./dist/routing.d.cts",
      "import": "./dist/routing.mjs",
      "require": "./dist/routing.cjs"
    },
    "./analytics": {
      "types": "./dist/analytics.d.cts",
      "import": "./dist/analytics.mjs",
      "require": "./dist/analytics.cjs"
    },
    "./supabaseServer": {
      "types": "./dist/supabaseServer.d.cts",
      "import": "./dist/supabaseServer.mjs",
      "require": "./dist/supabaseServer.cjs"
    },
    "./supabaseClient": {
      "types": "./dist/supabaseClient.d.cts",
      "import": "./dist/supabaseClient.mjs",
      "require": "./dist/supabaseClient.cjs"
    },
    "./server": {
      "types": "./dist/server.d.cts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    },
    "./useConsentMode": {
      "types": "./dist/useConsentMode.d.cts",
      "import": "./dist/useConsentMode.mjs",
      "require": "./dist/useConsentMode.cjs"
    },
    "./components/product": {
      "types": "./dist/components/product.d.cts",
      "import": "./dist/components/product.mjs",
      "require": "./dist/components/product.cjs"
    },
    "./components/basket": {
      "types": "./dist/components/basket.d.cts",
      "import": "./dist/components/basket.mjs",
      "require": "./dist/components/basket.cjs"
    },
    "./components/ui": {
      "types": "./dist/components/ui.d.cts",
      "import": "./dist/components/ui.mjs",
      "require": "./dist/components/ui.cjs"
    },
    "./components/context": {
      "types": "./dist/components/context.d.cts",
      "import": "./dist/components/context.mjs",
      "require": "./dist/components/context.cjs"
    },
    "./styles": "./dist/index.scss"
  },
  "types": "./dist/index.d.cts",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run typedoc-watcher\" \"npm run storybook\" --raw",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "typedoc-watcher": "npm run build-typedoc && chokidar \"src/lib/**/*.ts\" -c \"npm run build-typedoc\"",
    "build-storybook": "npm run build-typedoc && storybook build && xcopy public storybook-static /y",
    "build-typedoc": "npx typedoc --plugin typedoc-plugin-markdown --plugin typedoc-plugin-rename-defaults",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsdown && npm run copy-scss",
    "predeploy": "npm run build && npm run build-storybook",
    "deploy": "gh-pages -d storybook-static",
    "pub": "npm run deploy && npm publish",
    "copy-scss": "cpy \"src/**/*.@(scss|css)\" dist --parents"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "bootstrap": "^5.3.8",
    "dinero.js": "^1.9.1",
    "gh-pages": "^6.3.0",
    "locale-currency": "^1.0.0",
    "motion": "^12.34.3",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": ">=18",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@tsdown/css": "^0.21.9",
    "@types/dinero.js": "^1.9.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^16.5.0",
    "next": "^16.3.4",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.3.5",
    "tsdown": "^0.21.9",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react-dom": ">=18"
  }
}
