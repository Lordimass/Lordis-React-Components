{
  "name": "lordis-react-components",
  "type": "module",
  "version": "1.5.7",
  "description": "My personal React component library.",
  "homepage": "https://lordimass.github.io/Lordis-React-Components",
  "bugs": {
    "url": "https://github.com/Lordimass/Lordis-React-Components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lordimass/Lordis-React-Components.git"
  },
  "license": "Apache-2.0",
  "author": "Lordimass (lordimass.net)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "requre": "./dist/index.cjs",
      "types": "./dist/index.d.cts"
    },
    "./styles": "./dist/index.scss",
    "./*": "./dist/*"
  },
  "types": "./dist/index.d.cts",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run typedoc\" \"npm run storybook\" --raw",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "typedoc": "npx typedoc --plugin typedoc-plugin-markdown --plugin typedoc-plugin-rename-defaults --watch --preserveWatchOutput",
    "build-storybook": "npm run build-typedoc && storybook build && xcopy public storybook-static /y",
    "build-typedoc": "npx typedoc --plugin typedoc-plugin-markdown --plugin typedoc-plugin-rename-defaults",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsdown && npm run copy-scss",
    "predeploy": "npm run build && npm run build-storybook",
    "deploy": "gh-pages -d storybook-static",
    "pub": "npm run deploy && npm publish",
    "copy-scss": "cpy \"src/**/*.@(scss|css)\" dist --parents"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dinero.js": "^1.9.1",
    "gh-pages": "^6.3.0",
    "locale-currency": "^1.0.0",
    "motion": "^12.34.3",
    "react": "^19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "@supabase/supabase-js": "^2.105.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/addon-vitest": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tsdown/css": "^0.21.9",
    "@types/dinero.js": "^1.9.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "cpy-cli": "^7.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.3.5",
    "tsdown": "^0.21.9",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
