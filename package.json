{
  "name": "lordis-react-components",
  "type": "module",
  "version": "1.1.1",
  "description": "My personal React component library.",
  "homepage": "https://github.com/Lordimass/Lordis-React-Components",
  "bugs": {
    "url": "https://github.com/Lordimass/Lordis-React-Components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lordimass/Lordis-React-Components.git"
  },
  "license": "Apache-2.0",
  "author": "Lordimass (lordimass.net)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run typedoc\" \"npm run storybook\" --raw",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "typedoc": "npx typedoc --plugin typedoc-plugin-markdown --plugin typedoc-plugin-rename-defaults --watch --preserveWatchOutput",
    "build-storybook": "storybook build",
    "build-typedoc": "npx typedoc --plugin typedoc-plugin-markdown --plugin typedoc-plugin-rename-defaults",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build-typedoc && npm run build-storybook",
    "pub": "tsup && npm publish"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dinero.js": "^1.9.1",
    "locale-currency": "^1.0.0",
    "motion": "^12.34.3",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@types/dinero.js": "^1.9.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.3.3",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "storybook": "^10.3.3",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
